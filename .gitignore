# Python cache & build artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
*.dist-info/
.Python
.pytest_cache/

# Virtual environment (project root is the venv or standard envs)
bin/
include/
lib/
lib64
lib64/
etc/
share/
pyvenv.cfg
.venv/
venv/
env/

# Environment & secrets
.env

# Logs
logs/

# Metrics & Telemetry runtime data
data/metrics/*.csv
!data/metrics/.gitkeep
data/scratch/

# Database & SQLite runtime caches
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.bin
data/*.db
memories/**/*.db

# Auto-generated tools & test files
tools/
tests/

# Memory persistence & runtime data
memories/**/.cursor
memories/**/working_memory.json
memories/**/json/*.json
!memories/**/json/.gitkeep
data/.mavis_*
.mavis_*

# Vosk model zip (large binary, model dir is needed but zip is not)
models/

# IDE / OS / Editor swap files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~
