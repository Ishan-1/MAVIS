# Python cache & build artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
*.dist-info/
.Python
.pytest_cache/

# Virtual environment (project root is the venv or standard envs)
bin/
include/
lib/
lib64
lib64/
etc/
share/
pyvenv.cfg
.venv/
venv/
env/

# Environment & secrets
.env

# Logs
logs/

# Metrics & Telemetry runtime data
data/metrics/*.csv
!data/metrics/.gitkeep
data/scratch/

# Database & SQLite runtime caches
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.bin
data/*.db
memories/**/*.db

# User-specific runtime data
data/user_profile.json
data/emails.json

# Auto-generated tools & agents
tools/*
!tools/__init__.py
!tools/run_shell_command.py
!tools/search_web.py

agents/*
!agents/__init__.py
!agents/semantic_transform.py

